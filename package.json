{
  "name": "orgii",
  "version": "1.3.0",
  "description": "Self-evolving agentic development framework — ORGII desktop app",
  "main": "src/index.tsx",
  "scripts": {
    "prepare": "husky install",
    "postinstall": "node scripts/setup/postinstall.mjs",
    "dev:frontend": "node scripts/dev/webpack-server.js",
    "dev:frontend:rspack": "node scripts/dev/rspack-server.js",
    "dev:frontend:light": "ORGII_LIGHT_DEV=true FAST_DEV=true DEV_SOURCEMAPS=false node scripts/dev/webpack-server.js",
    "dev:cpu-monitor": "bash scripts/dev/cpu-monitor.sh",
    "diag:process": "node tools/org2-diagnostics/cli.mjs process",
    "diag:memory": "node tools/org2-diagnostics/cli.mjs memory",
    "diag:test": "node --test tools/org2-diagnostics/test/*.test.mjs",
    "build": "webpack --config config/webpack.config.js --mode production",
    "download": "python3 scripts/tools/download.py",
    "download:sidecars": "python3 scripts/tools/download_sidecars.py",
    "tauri:dev": "node scripts/dev/tauri-launcher.cjs",
    "tauri:dev:light": "node scripts/dev/tauri-launcher.cjs --light",
    "tauri:dev:rspack": "node scripts/dev/tauri-launcher.cjs --rspack",
    "tauri:dev:webpack": "node scripts/dev/tauri-launcher.cjs --webpack",
    "tauri:dev:only": "node scripts/tauri/run-with-features.cjs dev",
    "build:release": "rm -rf build node_modules/.cache && webpack --config config/webpack.config.js --mode production",
    "tauri:build": "node scripts/tauri/run-with-features.cjs build",
    "tauri:build:fast": "node scripts/tauri/build-fast-parallel.cjs",
    "tauri:build:fast:dual": "node scripts/tauri/build-fast-dual.cjs",
    "tauri:open:instance": "node scripts/tauri/open-instance.cjs",
    "tauri:build:fast:serial": "node scripts/tauri/run-with-features.cjs build -- --profile dev-build",
    "tauri:build:fast:local": "node scripts/tauri/build-fast-local.cjs",
    "tauri:build:fast:open": "node scripts/tauri/build-fast-open.cjs",
    "tauri:build:release": "node scripts/tauri/run-with-features.cjs build",
    "clean:cache": "node scripts/dev/clean-cache-if-large.js --node-cache",
    "clean:auto": "node scripts/dev/clean-cache-if-large.js",
    "clean:report": "node scripts/dev/clean-cache-if-large.js --report",
    "clean:stale": "node scripts/dev/clean-cache-if-large.js --stale",
    "clean:worktrees": "node scripts/dev/clean-cache-if-large.js --worktrees",
    "clean:full": "node scripts/dev/clean-cache-if-large.js --full",
    "scripts:test": "node --test scripts/dev/*.test.cjs",
    "analyze": "webpack --config config/webpack.config.js --mode production --profile --json > build/stats.json && webpack-bundle-analyzer build/stats.json",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:fast": "tsgo --noEmit --pretty false",
    "lint": "pnpm lint:fast && eslint src/ --ext .ts,.tsx,.js,.jsx --max-warnings 0 --report-unused-disable-directives",
    "lint:fast": "oxlint -c .oxlintrc.json --max-warnings 0 src",
    "lint:fix": "eslint src/ --ext .ts,.tsx,.js,.jsx --fix --report-unused-disable-directives",
    "lint:file": "eslint",
    "lint:file:fix": "eslint --fix",
    "cargo:check": "cd src-tauri && cargo check",
    "cargo:clippy": "cd src-tauri && cargo clippy",
    "cargo:test": "cd src-tauri && cargo test --workspace --no-fail-fast",
    "cargo:test:lib": "cd src-tauri && cargo test --lib --no-fail-fast",
    "cargo:test:agent_core": "cd src-tauri && cargo test -p agent_core",
    "cargo:test:agent_sessions": "cd src-tauri && cargo test --lib agent_sessions::",
    "cargo:test:api": "cd src-tauri && cargo test --lib api::",
    "check:circular": "node scripts/quality/check-circular-dependencies.mjs",
    "check:test-placement": "node scripts/quality/check-test-placement.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:watch": "vitest --config config/vitest.config.ts",
    "check:unused-exports": "knip",
    "check:unused-exports:all": "knip --include files,dependencies,devDependencies,exports,types,nsExports,nsTypes",
    "check:e2e-oauth-guards": "node scripts/quality/check-e2e-oauth-guards.mjs",
    "check:i18n:cloud": "node scripts/quality/check-missing-i18n-keys.mjs --namespace navigation --prefix cloud && node scripts/quality/check-missing-i18n-keys.mjs --namespace navigation --prefix collaboration.forkImported"
  },
  "keywords": [
    "orgii",
    "agent",
    "tauri",
    "desktop"
  ],
  "author": "YORG-AI",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@a2ui/react": "^0.10.0",
    "@a2ui/web_core": "^0.10.0",
