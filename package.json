    "prettier-plugin-tailwindcss": "^0.8.1",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.18.0",
    "sass": "^1.69.5",
    "sass-embedded": "^1.103.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^3.3.3",
    "swc-loader": "^0.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9",
