+/**
+ * Restores the module every per-icon declaration imports:
+ * the published 4.3.0 package ships 6,029 `dist/types/<Icon>.d.ts` files that
+ * all do `import type { IconSvgObject } from './types'`, but omits this file.
+ * With `skipLibCheck` the unresolved import silently degrades every icon to
+ * `any`, which lets `createElement(SomeIcon, …)` / `<SomeIcon/>` typecheck
+ * while crashing at runtime. Definition mirrors the inline `IconSvgObject` in
+ * `dist/types/index.d.ts`.
+ */
+export type IconSvgObject =
+  | [
+      string,
+      {
+        [key: string]: string | number;
+      },
+    ][]
+  | readonly (readonly [
+      string,
+      {
+        readonly [key: string]: string | number;
+      },
+    ])[];
